# 默认配置都已写在 src/config.ts，无需创建 .env 即可 npm start。
# 下面内容仅用于本机环境不同或需要临时切换时覆盖默认值。

# PORT=3100
# AGENT_MODEL=provider/model-id

# 默认使用 MySQL；需要验证文件回退时再取消注释。
# NEW_AGENT_STORAGE=file
# NEW_AGENT_DATA_DIR=data

# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=new_agent
# MYSQL_USER=root
# MYSQL_PASSWORD=本机密码
# MYSQL_CONNECTION_LIMIT=10
# MYSQL_CONNECT_TIMEOUT_MS=5000

# 正式部署时请覆盖 Cookie 签名密钥，并在 HTTPS 环境开启 Secure。
# AUTH_SECRET=至少32位随机字符串
# AUTH_COOKIE_SECURE=true
# AUTH_MAX_AGE_SECONDS=604800
