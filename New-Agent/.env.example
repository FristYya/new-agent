# HTTP 服务端口
PORT=3100

# 从第 1 节课开始使用。格式为 provider/model，例如 anthropic/claude-sonnet-4-5。
# 留空时由课堂代码选择 Pi 中第一个可用模型。
AGENT_MODEL=

# 第 4 节课之前保持 memory；第五节可切换为 mysql。
NEW_AGENT_STORAGE=memory

# MySQL 仅在第五节的扩展练习中使用。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=new_agent
MYSQL_USER=new_agent
MYSQL_PASSWORD=
